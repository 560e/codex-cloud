{
  "name": "codex-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write src server shared scripts/*.ts scripts/*.mjs tests *.ts *.json *.html \"README*.md\" \"docs/**/*.md\" scripts/install/*.mjs",
    "format:check": "prettier --check src server shared scripts/*.ts scripts/*.mjs tests *.ts *.json *.html \"README*.md\" \"docs/**/*.md\" scripts/install/*.mjs",
    "check": "npm run typecheck && npm run format:check && npm test",
    "verify": "npm run check && npm run build && npm run test:e2e",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "password": "tsx scripts/password.ts",
    "doctor": "tsx scripts/doctor.ts",
    "smoke:codex": "tsx scripts/smoke-codex.ts",
    "backup": "node dist/scripts/backup.js",
    "install:check": "node scripts/install/setup.mjs --check",
    "setup": "node scripts/install/setup.mjs",
    "migrate": "node dist/scripts/migrate.js",
    "export:source": "python3 scripts/export-source.py",
    "test:export": "python3 -B tests/export-source.test.py"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "tar": "^7.5.22",
    "undici": "^7.30.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
